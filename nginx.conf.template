server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Serve static files
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy Docker API requests to the socket proxy.
    # DOCKER_API_UPSTREAM is substituted at container start (default: docker-socket:2375).
    location ~ ^/v[0-9]+\.[0-9]+/ {
        proxy_pass http://${DOCKER_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $proxy_host;
    }
}
